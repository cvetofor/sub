#!/usr/bin/env bash
# Install as /usr/local/sbin/cvety-deploy, owner root:root, mode 0750.
# Only invocation: sudo /usr/local/sbin/cvety-deploy <40-character SHA> [--migrate]
set -Eeuo pipefail

readonly SITE_DIR="/var/www/cvety"
readonly RELEASE_USER="codex-sub"
target=${1:-}
migrate=${2:-}

die() { echo "cvety-deploy: $*" >&2; exit 1; }
[[ $# -ge 1 && $# -le 2 ]] || die "usage: cvety-deploy <SHA> [--migrate]"
[[ "$target" =~ ^[0-9a-f]{40}$ ]] || die "commit must be a lowercase 40-character SHA"
[[ -z "$migrate" || "$migrate" == "--migrate" ]] || die "unknown option: $migrate"
[[ -d "$SITE_DIR/.git" ]] || die "$SITE_DIR is not a Git working tree"

exec 9>/var/lock/cvety-deploy.lock
flock -n 9 || die "another deployment is already running"
cd "$SITE_DIR"

# The working tree was bootstrapped shallow; fetch full history once so an
# explicit deployment of an earlier known-good SHA can serve as an rollback.
git fetch --quiet --unshallow origin redesign 2>/dev/null ||
  git fetch --quiet origin redesign
git cat-file -e "$target^{commit}" || die "commit is unavailable"
git merge-base --is-ancestor "$target" origin/redesign ||
  die "commit is not reachable from origin/redesign"

previous=$(git rev-parse HEAD)
dependencies_changed=0
if ! git diff --quiet "$previous" "$target" -- composer.lock; then dependencies_changed=1; fi

build_stage="$SITE_DIR/.deploy/build/$target"
if ! git diff --quiet "$previous" "$target" -- package-lock.json package.json vite.config.* resources; then
  [[ -f "$build_stage/manifest.json" ]] || die "built frontend has not been staged"
fi

down=0
bring_up() {
  if [[ "$down" == 1 ]]; then sudo -u www-data php artisan up || true; fi
}
trap bring_up EXIT
sudo -u www-data php artisan down --retry=60
down=1

# Runtime data are ignored by Git: .env, storage, vendor and public/build.
git reset --hard "$target"
git ls-files -z | xargs -0 -r chown "$RELEASE_USER:$RELEASE_USER"

if [[ "$dependencies_changed" == 1 ]]; then
  COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader
fi

if [[ -d "$build_stage" ]]; then
  install -d -o www-data -g www-data -m 0755 public/build
  rsync -a --delete --chown=www-data:www-data "$build_stage/" public/build/
fi

if [[ "$migrate" == "--migrate" ]]; then sudo -u www-data php artisan migrate --force; fi
sudo -u www-data php artisan optimize:clear
sudo -u www-data php artisan config:cache
sudo -u www-data php artisan route:cache
sudo -u www-data php artisan view:cache
sudo -u www-data php artisan up
down=0
echo "Deployed $(git rev-parse HEAD) to $SITE_DIR"
